# macOS metadata (recursive across all subfolders)
.DS_Store
**/.DS_Store

# Python bytecode caches (recursive across all subfolders)
__pycache__/
*.py[cod]
*$py.class

# Flyte / Union CLI local config (generated by `flyte create config`)
.flyte/

# Local MedMNIST exports
dermamnist_224/

# Training runs / checkpoints
runs/
*.pt
